{
  "name": "3d-druck",
  "private": true,
  "type": "module",
  "description": "3D-Druck-Werkzeuge: Web-Tools für Fusion 360 und den 3D-Druck (Muster-Generator …)",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "npm run test:muster",
    "test:muster": "node --test \"MusterGenerator/tests/*.test.mjs\" && python3 MusterGenerator/tests/test_fusion_script.py",
    "validate:muster": "node MusterGenerator/tests/tools/generate-exports.mjs build/exports && python3 MusterGenerator/tests/tools/validate_exports.py build/exports"
  },
  "engines": {
    "node": ">=22"
  }
}
